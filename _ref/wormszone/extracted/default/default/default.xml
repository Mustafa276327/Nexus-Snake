                        <text multiline="true" id="txtRestartWithBonus" size="130 64" position="103 12" metrics="line" font="common/fonts/NotoSans-CondensedBlack.ttf" font_size="40" font_effect_bundle="common/fonts/effects.fe" font_effect_name="outline_green" />

                        <nine_patch sprite_id="nine_patch_holder_powerups:game" patch="12 12 2 2" size="108 42" anchor="0" position="161 -20">
                            <image sprite_id="items_btn_magnet:common" position="34 20" scale="0.52" />
                            <image sprite_id="items_btn_speedup:common" position="61 20" scale="0.52" />
                            <image sprite_id="items_btn_zoom:common" position="88 20" scale="0.52" />
                            <text text="+" size="30 34" position="5 -2" metrics="line" trim_container="true" font="common/fonts/NotoSans-CondensedBlack.ttf" font_size="50" font_effect_bundle="common/fonts/effects.fe" font_effect_name="outline13" />
