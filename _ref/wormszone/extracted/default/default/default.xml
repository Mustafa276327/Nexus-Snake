            </layout>

            <alignment h_align="center" v_align="top">
                <nine_patch sprite_id="nine_patch_header:common" patch="0 1 12 2" size="900 64" hotspot="450 0" position="0 22" color="40000000">
                    <text id="gameover_popup_title" size="574 46" position="163 2" metrics="line" font="common/fonts/NotoSans-CondensedBlack.ttf" font_size="50" color="ffffff79" shadow_offset="2 3" shadow_color="33000000" />
                </nine_patch>
            </alignment>

            <alignment h_align="right" v_align="top">
                <button id="btnClose" sprite_id="btn_small_orange:common" touch_padding="60 60 60 54" position="-55 55" scale="0.64" pressed_scale="0.97">
                    <image sprite_id="icon_cross_orange:common" position="50 51" />
                </button>
            </alignment>
        </autoload>
    </gameover_popup>
</root>
