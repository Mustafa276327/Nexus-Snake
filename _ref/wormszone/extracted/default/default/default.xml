<?xml version="1.0" encoding="UTF-8"?>
<root>
    <atlases_list>
        <default path="default/atlas_default.xml" />
        <common path="common/atlas_common.xml" />
        <game path="common/atlas_game.xml" />
    </atlases_list>

    <lobby>
        <title id="logo" sprite_id="logo:default" amplitude="10" />

        <play_button_default>
            <play_button id="btnPlay" sprite_id="btn_play:common" sprite_id_pressed="btn_play_pressed:common" scale="0.95">
                <text id="button_play_title" size="350 77" position="23 15" metrics="line" font="common/fonts/NotoSans-CondensedMedium.ttf" font_size="90" font_effect_bundle="common/fonts/effects.fe" font_effect_name="outline" />
            </play_button>
        </play_button_default>

        <decoration_front>
            <snow snowflakes_list="snowflake_0 snowflake_1 snowflake_2 snowflake_3 snowflake_4 snowflake_5" />
        </decoration_front>
    </lobby>

    <wardrobe>
        <decoration_front>
            <snow snowflakes_list="snowflake_0 snowflake_1 snowflake_2 snowflake_3 snowflake_4 snowflake_5" />
        </decoration_front>
    </wardrobe>

    <game>
    </game>

    <food_resources>
        <shine sprite_id="shine:default" />
        <coin sprite_id="coin:game" value="1" scale="0.65" radius="70" />

        <powerups>
            <magnet sprite_id="items_powerup_magnet:common" value="250" scale="0.75" rotation="30" />
            <multiply sprite_id="items_powerup_multiply:common" value="500" scale="0.75" rotation="25" />
            <radar sprite_id="items_powerup_radar:common" value="250" scale="0.75" rotation="-5" />
            <speedup sprite_id="items_powerup_speedup:common" value="250" scale="0.75" rotation="-15" />
            <turn sprite_id="items_powerup_turn:common" value="250" scale="0.75" rotation="-35" />
            <zoom sprite_id="items_powerup_zoom:common" value="250" scale="0.75" rotation="5" />
        </powerups>

        <triggers>
            <piggy sprite_id="piggybank:game" value="250" />
        </triggers>
    </food_resources>

    <lastchance_popup>
        <autoload size="654 720" shade="1" shade_color="dc000000" overscale="1.1" speed="10" direction="0 0">
            <alignment h_align="center" v_align="top">
                <image sprite_id="shine_soft:common" scale="45" color="ff4d58c0" />
                <spine spine_desc="common/animations/menu/particles.json" spine_atlas="common/animations/menu/particles.atlas" spine_animation="idle" spine_loop="true" position="0 -450" />
            </alignment>

            <image sprite_id="progress_circle:common" position="327 215" color="33ffffff">
                <text id="txtTimeout" size="70" position="47 39" metrics="line" font="common/fonts/NotoSans-CondensedBlack.ttf" font_size="90" color="fff7dd10" />

                <bounds position="82 64" anchor="0.5">
                    <text id="txtTimeoutFly" size="70" metrics="line" font="common/fonts/NotoSans-CondensedBlack.ttf" font_size="90" color="fff7dd10" />
                </bounds>

                <clock id="clockTimer" sprite_id="progress_circle:common" position="82" scale="0.7" />
            </image>

            <stack orientation="vertical" spacing="15" position="327 332" anchor="0.5 0">
                <stack orientation="horizontal" spacing="15" anchor="0">
                    <nine_patch sprite_id="nine_patch_info_back:game" patch="18 18 4 4" autosize="true" anchor="0" padding="14 -5 14 7">
                        <stack orientation="horizontal" anchor="0.5" position="112 30" spacing="15">
                            <node size="70">
                                <image sprite_id="shine_soft:common" position="35 43" color="ff1e5984" scale="5" />
                                <image sprite_id="icon_cup:game" position="35" />
                            </node>

                            <text text="--" id="txtRank" size="128 45" metrics="line" trim_container="true" font="common/fonts/NotoSans-CondensedBlack.ttf" font_size="50" />
                        </stack>
                    </nine_patch>

                    <stack>
                        <nine_patch id="weightBack" sprite_id="nine_patch_info_back:game" patch="18 18 4 4" autosize="true" anchor="0" padding="14 -5 14 6">
                            <stack orientation="horizontal" anchor="0.5" position="192 30" spacing="15">
                                <node size="70">
                                    <image id="imgWeightShine" visible="0" sprite_id="shine_soft:common" position="35 43" color="ff1e5984" scale="5" />
                                    <image id="imgIconWeight" sprite_id="icon_weight:game" position="0 69" hotspot="0 69" />
                                </node>

                                <text id="txtWeight" text="0" size="253 45" metrics="line" trim_container="true" font="common/fonts/NotoSans-CondensedBlack.ttf" font_size="50" />
                            </stack>
                        </nine_patch>
                    </stack>
                </stack>

                <stack orientation="horizontal" spacing="15" anchor="0">
                    <nine_patch sprite_id="nine_patch_info_back:game" patch="18 18 4 4" size="364 48" anchor="0">
                        <text id="treasure_hunter_popup_collect" size="142 26" position="20 8" h_align="left" metrics="line" font="common/fonts/NotoSans-CondensedBlack.ttf" font_size="50" />

                        <stack orientation="horizontal" alignment="top" anchor="1 0" position="350 8" spacing="8">
                            <stack id="grpEventCurrency" visible="0" orientation="horizontal" alignment="top" spacing="5">
                                <node size="28 31">
                                    <node id="imgEventCurrency" position="14 17" scale="0.23" />
                                </node>

                                <text id="txtEventCurrency" size="56 26" metrics="line" trim_container="true" font="common/fonts/NotoSans-CondensedBlack.ttf" font_size="50" />
                            </stack>

                            <text id="txtEventCurrencySeparator" visible="0" text="/" size="15 26" metrics="line" trim_container="true" font="common/fonts/NotoSans-CondensedBlack.ttf" font_size="50" />

                            <bounds id="grpCoins">
