                    </mask>

                    <text multiline="true" id="txtRestart" size="130 64" position="103 11" metrics="line" font="common/fonts/NotoSans-CondensedBlack.ttf" font_size="40" font_effect_bundle="common/fonts/effects.fe" font_effect_name="outline_green" />
