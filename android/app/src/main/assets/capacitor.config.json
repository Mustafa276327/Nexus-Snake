{
	"appId": "com.nexus.snake",
	"appName": "Nexus Snake",
	"webDir": "www",
	"server": {
		"url": "http://localhost",
		"cleartext": true
	},
	"bundledWebRuntime": false,
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": true
	},
	"plugins": {
		"Preferences": {
			"group": "nexus-snake"
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0d1117"
		}
	}
}
